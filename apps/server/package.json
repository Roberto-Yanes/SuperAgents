{
  "name": "@ega/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "openapi": "tsx scripts/gen-openapi.ts",
    "bootstrap": "tsx src/cli.ts bootstrap",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.94",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@composio/core": "0.31.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/swagger": "^9.9.5",
    "@fastify/websocket": "^11.3.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "^7.0.179",
    "baileys": "7.0.0-rc14",
    "better-auth": "^1.7.27",
    "cron-parser": "^5.10.6",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "imapflow": "^2.12.2",
    "mailparser": "^3.15.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.39.0",
    "pino": "^10.4.0",
    "prisma": "7.10.1",
    "prom-client": "^15.1.3",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.39",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
