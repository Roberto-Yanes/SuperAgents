# ── Servidor ─────────────────────────────────────────────
NODE_ENV=production
# api | worker | all (MVP: all, un solo proceso 24/7)
ROLE=all
PORT=3000
PUBLIC_URL=https://agentes.example.com
LOG_LEVEL=info
CORS_ORIGINS=https://app.example.com
# Proxies de confianza delante del servidor (Caddy = 1; 0 si se expone directo)
TRUST_PROXY=1
# Alta pública de usuarios: disabled (crear usuarios con la CLI add-user) | enabled
AUTH_SIGNUP=disabled
# Hosts permitidos como baseURL de conexiones LLM (coma). Vacío = cualquiera salvo metadatos/link-local
LLM_BASEURL_ALLOWLIST=
# Guarda multi-tenant: error | warn | off (por defecto warn en producción)
# TENANT_GUARD=warn

# ── Datos ────────────────────────────────────────────────
POSTGRES_PASSWORD=cambia-esto
DATABASE_URL=postgresql://ega:cambia-esto@postgres:5432/ega

# ── Seguridad ────────────────────────────────────────────
# 32 bytes en base64: openssl rand -base64 32
SECRET_KEY=
# Opcional, para rotar SECRET_KEY sin perder secretos guardados
SECRET_KEY_OLD=
# openssl rand -base64 48
BETTER_AUTH_SECRET=

# ── Ejecución ────────────────────────────────────────────
WORKER_CONCURRENCY=4
RUN_MAX_STEPS=12
APPROVAL_TTL_HOURS=72
RATE_LIMIT_MAX=300
# Archivos y sesiones de WhatsApp por Baileys (volumen persistente)
DATA_DIR=/app/data

# ── Caddy ────────────────────────────────────────────────
DOMAIN=agentes.example.com
